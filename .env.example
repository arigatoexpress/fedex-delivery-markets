# Local pilot settings. Do not commit real secrets.

# Optional. If set, /api/admin/* and /api/oracle/events require:
# Authorization: Bearer <DELIVERY_MARKETS_ADMIN_TOKEN>
DELIVERY_MARKETS_ADMIN_TOKEN=

# Optional. If set, oracle events must be signed with this EVM address.
ORACLE_SIGNER_ADDRESS=

# Optional. Defaults to ./data
DELIVERY_MARKETS_DATA_DIR=

# Optional. Server mode toggle used for production-only behavior.
NODE_ENV=

# Optional. API listen port for the Node server.
PORT=

# Optional. Max accepted JSON request body size in bytes.
MAX_JSON_BODY_BYTES=

# Optional. Enables open admin routes in non-production for local demos.
ALLOW_DEV_OPEN_ADMIN=

# Read-only wallet readiness. These are public addresses only.
DELIVERY_MARKETS_TESTNET_WALLET_ADDRESS=
WALLET_READINESS_TIMEOUT_MS=5000

# Optional Solana reference rail. Not required for the current EVM receipt path.
SOLANA_TESTNET_WALLET_ADDRESS=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional. Default base URL for browser smoke tests.
DELIVERY_MARKETS_BASE_URL=

# Optional. Base liquidity seed used by the private AMM quote model.
PRIVATE_AMM_BASE_LIQUIDITY_USD=

# Optional. Allows fixture oracle-event ingestion outside production.
ALLOW_FIXTURE_ORACLE_EVENTS=

# Optional. Max in-memory/order-ledger records to retain before pruning.
PILOT_LEDGER_MAX_RECORDS=

# Testnet-only deploy placeholders. The deploy script still requires DEPLOY_CONTRACTS=true.
ROBINHOOD_CHAIN_RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEPLOY_CONTRACTS=false
DEPLOY_PRIVATE_MARKET_CONTRACT=false
PRIVATE_MARKET_CONTRACT_ADDRESS=

# Optional test fixture only. Hedera operator account identifier for readiness tests.
HEDERA_OPERATOR_ID=

# Optional test fixture only. Hedera operator private key placeholder for readiness tests.
HEDERA_OPERATOR_KEY=

# Optional test fixture only. Hedera topic identifier placeholder for readiness tests.
HEDERA_TOPIC_ID=

# Optional test fixture only. Polymarket private key placeholder for readiness tests.
POLYMARKET_PRIVATE_KEY=

# Optional test fixture only. Polymarket deposit wallet placeholder for readiness tests.
POLYMARKET_DEPOSIT_WALLET_ADDRESS=

# Optional test fixture only. Polymarket API key placeholder for readiness tests.
POLYMARKET_API_KEY=
