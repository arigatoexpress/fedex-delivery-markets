{
  "name": "fedex-delivery-markets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paper-only FedEx delivery-time prediction market demo with Robinhood Chain and Hedera oracle architecture.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5178",
    "start": "node dist-server/index.js",
    "contracts:build": "tsx scripts/build-contract-artifacts.ts",
    "wallet:readiness": "tsx scripts/wallet-readiness.ts",
    "deploy:robinhood:testnet": "tsx scripts/deploy-robinhood-chain.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc --noEmit && vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist-server/index.js --external:@cowprotocol/cow-sdk",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@cowprotocol/cow-sdk": "^9.2.2",
    "@hono/node-server": "^1.19.15",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4",
    "viem": "^2.55.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.5",
    "playwright": "^1.60.0",
    "solc": "^0.8.35",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "shell-quote": "^1.10.0",
    "tmp": "^0.2.5",
    "ws": "^8.21.0"
  }
}
